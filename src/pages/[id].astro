                                                                        <dt class="text-xs uppercase tracking-[0.3em] text-muted-foreground">Downloads</dt>
                                                                        <dd class="text-base font-semibold text-foreground">{downloadsCount} {downloadLabel}</dd>
                                                                </div>
                                                        </dl>
                                                </div>
                                        </article>

                                        {scoringEnabled ? (
                                                <section class="surface overflow-hidden">
                                                        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/60 bg-background/60 px-6 py-5 sm:px-10">
                                                                <div class="space-y-1">
                                                                        <h2 class="text-lg font-semibold text-foreground">Submit a solution</h2>
                                                                        <p class="text-sm text-muted-foreground">
                                                                                Score your output against the official rules directly from the browser.
                                                                        </p>
                                                                </div>
                                                                <span class="inline-flex items-center rounded-full border border-border/40 px-3 py-1 text-xs uppercase tracking-[0.32em] text-muted-foreground">
                                                                        Beta
                                                                </span>
                                                        </div>
                                                        <div class="px-6 py-6 sm:px-10">
                                                                {scoringAvailable ? (
                                                                        <form class="space-y-6" method="post" data-scoring-form data-year={hashcode.data.year} data-round={hashcode.data.round}>
                                                                                <div class="space-y-2">
                                                                                        <label class="text-sm font-medium text-foreground" for="dataset">
                                                                                                Dataset
                                                                                        </label>
                                                                                        <select
                                                                                                id="dataset"
                                                                                                name="dataset"
                                                                                                class="block w-full rounded-2xl border border-border/60 bg-background/60 px-4 py-3 text-sm text-foreground transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                                                                                                required
                                                                                        >
                                                                                                <option value="" disabled selected>
                                                                                                        Select a dataset
                                                                                                </option>
                                                                                                {resources.inputs.map((input, index) => (
                                                                                                        <option value={input.name} selected={index === 0}>
                                                                                                                {datasetLabel(input.name)}
